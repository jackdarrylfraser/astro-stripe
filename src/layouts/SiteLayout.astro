---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A members-only publication.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root { color-scheme: light; font-family: system-ui, sans-serif; color: #17202a; background: #f7f8fa; }
      body { margin: 0; }
      header, main, footer { width: min(100% - 2rem, 54rem); margin-inline: auto; }
      header { padding-block: 1.5rem; border-bottom: 1px solid #dfe3e8; }
      nav { display: flex; gap: 1rem; align-items: center; }
      nav a:first-child { margin-right: auto; font-weight: 700; }
      main { min-height: 65vh; padding-block: 3rem; }
      footer { padding-block: 1.5rem; border-top: 1px solid #dfe3e8; color: #52606d; }
      a { color: #145da0; }
      button, .button { display: inline-block; border: 0; border-radius: .4rem; padding: .7rem 1rem; color: white; background: #145da0; font: inherit; text-decoration: none; cursor: pointer; }
      input { display: block; width: min(100%, 24rem); box-sizing: border-box; margin-block: .5rem 1rem; padding: .7rem; font: inherit; }
      .message { min-height: 1.5em; }
    </style>
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href="/">Astro Stripe</a>
        <a href="/pricing">Pricing</a>
        <a href="/sign-in">Sign in</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>Subscription access is verified securely on every protected page.</footer>
  </body>
</html>
